{
  "$schema": "../../schema/iac.schema.json",
  "version": 1,
  "project": {
    "key": "next-monorepo",
    "name": "next-monorepo"
  },
  "environments": {
    "development": {
      "files": [
        ".env.development"
      ]
    },
    "uat": {
      "files": [
        ".env.uat"
      ]
    },
    "nightly": {
      "files": [
        ".env.nightly"
      ]
    },
    "staging": {
      "files": [
        ".env.staging"
      ]
    },
    "preview": {},
    "production": {
      "files": [
        ".env.production"
      ]
    }
  },
  "providers": {
    "vercel": {
      "teamSlug": "vertile-ai",
      "projectDefaults": {
        "nodeVersion": "20.x",
        "enableAffectedProjectsDeployments": true
      },
      "deployments": {
        "dev": {
          "environment": "development",
          "teamSlug": "vertile-ai"
        },
        "uat": {
          "environment": "uat",
          "teamSlug": "vertile-ai"
        },
        "nightly": {
          "environment": "nightly",
          "teamSlug": "vertile-ai"
        },
        "prod": {
          "environment": "production",
          "teamSlug": "vertile-ai"
        }
      }
    }
  },
  "env": {
    "sync": {
      "apps": [
        "web",
        "admin"
      ],
      "sharedKey": "shared"
    },
    "metadata": {
      "shared": {
        "variables": [
          {
            "key": "NEXT_PUBLIC_APP_ENV",
            "example": "development",
            "encrypted": false,
            "browser": true,
            "values": {
              "development": "development",
              "staging": "preview",
              "production": "production"
            }
          },
          {
            "key": "NEXT_PUBLIC_API_BASE_URL",
            "example": "http://localhost:3000",
            "encrypted": false,
            "browser": true,
            "values": {
              "development": "http://localhost:3000",
              "staging": "https://preview-api.dynomic.example.com",
              "production": "https://api.dynomic.example.com"
            }
          },
          {
            "key": "ADMIN_NEXT_PUBLIC_APP_ENV",
            "example": "development",
            "encrypted": false,
            "browser": true,
            "values": {
              "development": "development",
              "staging": "preview",
              "production": "production"
            }
          },
          {
            "key": "ADMIN_NEXT_PUBLIC_API_BASE_URL",
            "example": "http://localhost:3001",
            "encrypted": false,
            "browser": true,
            "values": {
              "development": "http://localhost:3001",
              "staging": "https://preview-admin-api.dynomic.example.com",
              "production": "https://admin-api.dynomic.example.com"
            }
          }
        ]
      },
      "web": {
        "variables": [
          {
            "key": "DATABASE_URL",
            "example": "postgres://user:password@localhost:5432/dynomic",
            "encrypted": true,
            "browser": false,
            "values": {
              "development": "postgres://local-user:local-pass@localhost:5432/dynomic",
              "staging": "postgres://preview-user:preview-pass@preview-db.example.com/dynomic",
              "production": "postgres://prod-user:prod-pass@prod-db.example.com/dynomic"
            }
          },
          {
            "key": "STRIPE_SECRET_KEY",
            "example": "stripe-test-placeholder",
            "encrypted": true,
            "browser": false,
            "values": {
              "development": "stripe-test-dynomic-local-placeholder",
              "staging": "stripe-test-dynomic-placeholder",
              "production": "stripe-live-dynomic-placeholder"
            }
          }
        ]
      },
      "admin": {
        "variables": [
          {
            "key": "ADMIN_DATABASE_URL",
            "example": "postgres://user:password@localhost:5432/dynomic_admin",
            "encrypted": true,
            "browser": false,
            "values": {
              "development": "postgres://local-admin:local-pass@localhost:5432/dynomic_admin",
              "staging": "postgres://preview-admin:preview-pass@preview-db.example.com/dynomic_admin",
              "production": "postgres://prod-admin:prod-pass@prod-db.example.com/dynomic_admin"
            }
          },
          {
            "key": "ADMIN_SESSION_SECRET",
            "example": "admin-session-placeholder",
            "encrypted": true,
            "browser": false,
            "values": {
              "development": "local-admin-session-placeholder",
              "staging": "preview-admin-session-placeholder",
              "production": "prod-admin-session-placeholder"
            }
          }
        ]
      }
    }
  },
  "apps": [
    {
      "key": "web",
      "id": "prj_next_monorepo_web_placeholder",
      "name": "next-monorepo-web",
      "framework": "nextjs",
      "rootDirectory": "apps/web",
      "nodeVersion": "20.x",
      "domains": [
        "next-monorepo.example.com",
        {
          "name": "preview.next-monorepo.example.com",
          "gitBranch": "preview"
        }
      ]
    },
    {
      "key": "admin",
      "id": "prj_next_monorepo_admin_placeholder",
      "name": "next-monorepo-admin",
      "framework": "nextjs",
      "rootDirectory": "apps/admin",
      "nodeVersion": "20.x",
      "domains": [
        "admin.next-monorepo.example.com",
        {
          "name": "admin-preview.next-monorepo.example.com",
          "gitBranch": "preview"
        }
      ],
      "env": {
        "sharedPrefix": "ADMIN_"
      }
    }
  ],
  "domains": [
    {
      "name": "www.next-monorepo.example.com",
      "app": "web"
    }
  ]
}
