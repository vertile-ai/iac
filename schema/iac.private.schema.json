{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vertile.ai/schemas/iac.private.schema.json",
  "title": "Vertile AI IaC Private Values",
  "description": "Untracked encrypted environment values and provider-neutral credentials for an IaC version 2 manifest.",
  "type": "object",
  "required": ["version"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "credentials": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    }
  }
}
