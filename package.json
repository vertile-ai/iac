{
  "name": "@vertile-ai/iac",
  "version": "0.2.1",
  "description": "App-first portable infrastructure intent for Vercel, AWS, and DigitalOcean.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vertile-ai/iac.git"
  },
  "bugs": {
    "url": "https://github.com/vertile-ai/iac/issues"
  },
  "homepage": "https://github.com/vertile-ai/iac#readme",
  "bin": {
    "vertile-iac": "dist/src/cli.js",
    "vertile-iac-render": "dist/src/render.js",
    "vertile-iac-plan": "dist/src/plan.js",
    "vertile-iac-apply": "dist/src/apply.js",
    "vertile-iac-output": "dist/src/output.js",
    "vertile-iac-validate": "dist/src/validate.js",
    "vertile-iac-sync-env": "dist/src/sync-env.js",
    "vertile-iac-env": "dist/src/provision-env.js",
    "vertile-iac-github-actions": "dist/src/github-actions.js",
    "vertile-iac-projects": "dist/src/reconcile-project-settings.js",
    "vertile-iac-domains": "dist/src/reconcile-project-domains.js"
  },
  "files": [
    "dist",
    "docs",
    "schema",
    "examples",
    "!examples/**/.env",
    "!examples/**/.env.*",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm run build && node --test dist/test/*.test.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "sync-env": "node src/sync-env.mjs",
    "env:dry-run": "node src/provision-env.mjs",
    "env:apply": "node src/provision-env.mjs --apply",
    "github-actions:dry-run": "node src/github-actions.mjs",
    "github-actions:apply": "node src/github-actions.mjs --apply",
    "projects:dry-run": "node src/reconcile-project-settings.mjs",
    "projects:apply": "node src/reconcile-project-settings.mjs --apply",
    "domains:dry-run": "node src/reconcile-project-domains.mjs",
    "domains:apply": "node src/reconcile-project-domains.mjs --apply",
    "sync:landing-schema-docs": "node dist/scripts/sync-landing-schema-docs.js",
    "prepack": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@types/node": "24.0.15",
    "ajv": "8.17.1",
    "typescript": "5.8.3"
  }
}
