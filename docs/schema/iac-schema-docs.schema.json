{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vertile.ai/schemas/iac-schema-docs.schema.json",
  "title": "Vertile AI IaC Schema Documentation",
  "description": "Structured documentation rendered by landing pages for Vertile AI IaC schemas.",
  "type": "object",
  "required": ["title", "summary", "schemaPath", "packageSchemaPath", "sourcePackage", "sections"],
  "additionalProperties": true,
  "properties": {
    "$schema": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "schemaPath": { "type": "string", "minLength": 1 },
    "packageSchemaPath": { "type": "string", "minLength": 1 },
    "sourcePackage": { "type": "string", "minLength": 1 },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/section" }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "required": ["title", "summary", "fields"],
      "additionalProperties": true,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/field" }
        }
      }
    },
    "field": {
      "type": "object",
      "required": ["path", "type", "required", "description"],
      "additionalProperties": true,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "description": { "type": "string", "minLength": 1 }
      }
    }
  }
}
